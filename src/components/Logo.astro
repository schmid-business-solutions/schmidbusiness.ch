---
interface Props {
	inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<img
	class="logo"
	src={inverse ? '/logo-weiss.svg' : '/logo.svg'}
	width="544"
	height="119"
	alt="Schmid Business Solutions"
/>

<style>
	.logo {
		display: block;
		width: 156px;
		height: auto;
	}

	@media (max-width: 560px) {
		.logo {
			width: 128px;
		}
	}
</style>
